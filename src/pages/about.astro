---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import PhotoSlot from '../components/PhotoSlot.astro';
import EstimateBand from '../components/EstimateBand.astro';
import ClientsStrip from '../components/ClientsStrip.astro';
import { about, credentials, slots, nav } from '../content/site';
const creds = [...credentials, ...(slots.insurance.enabled && slots.insurance.text ? [slots.insurance.text] : [])];
---
<Base title={about.title} description={about.description} crumbs={[{ name: nav.find((n) => n.href === '/about')!.label, path: '/about' }]}>
  <PageHead h1={about.h1} />
  <section class="section">
    <div class="container split">
      <div class="split-text">
        <p class="lead lead-lg">{about.text}</p>
        <div class="callout">
          <h2 class="card-title">{about.credentialsHeading}</h2>
          <ul>{creds.map((c) => <li>{c}</li>)}</ul>
        </div>
        <p class="about-contact">{about.contactLead} <a href="/contact">{about.contactLink}</a></p>
      </div>
      <div class="split-media"><PhotoSlot image={about.image} ratio="tall" sizes="(min-width: 960px) 45vw, 100vw" widths={[480, 800, 1100]} eager /></div>
    </div>
  </section>
  <ClientsStrip />
  <EstimateBand />
</Base>
