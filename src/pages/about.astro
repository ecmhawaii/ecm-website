---
import Base from '../layouts/Base.astro';
import PhotoPlaceholder from '../components/PhotoPlaceholder.astro';
import { about } from '../content/site';
---
<Base title={about.title} description={about.description}>
  <section class="section">
    <div class="container">
      <h1>{about.h1}</h1>
      <p class="prose">{about.text}</p>
      <div class="callout" style="margin: 24px 0">
        <h2 class="card-title">{about.credentialsHeading}</h2>
        <ul>
          {about.credentials.map((line) => <li>{line}</li>)}
        </ul>
      </div>
      <div style="max-width: 640px">
        <PhotoPlaceholder ratio="16 / 9" />
      </div>
    </div>
  </section>
</Base>
