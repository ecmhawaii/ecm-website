---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import PhotoSlot from '../components/PhotoSlot.astro';
import CtaBand from '../components/CtaBand.astro';
import { about, credentials, slots, nav } from '../content/site';
const creds = [...credentials, ...(slots.insurance.enabled && slots.insurance.text ? [slots.insurance.text] : [])];
---
<Base title={about.title} description={about.description} crumbs={[{ name: nav.find((n) => n.href === '/about')!.label, path: '/about' }]}>
  <PageHead h1={about.h1} />
  <section class="section">
    <div class="container split">
      <div class="split-text">
        <p class="lead">{about.text}</p>
        <div class="callout">
          <h2 class="card-title">{about.credentialsHeading}</h2>
          <ul>{creds.map((c) => <li>{c}</li>)}</ul>
        </div>
      </div>
      <div class="split-media"><PhotoSlot slot="about" ratio="photo" /></div>
    </div>
  </section>
  <CtaBand />
</Base>
