---
import Base from '../layouts/Base.astro';
import { subcontractors as s, ui } from '../content/site';
const f = s.fields;
---
<Base title={s.title} description={s.description}>
  <section class="section">
    <div class="container">
      <h1>{s.h1}</h1>
      <p class="prose">{s.intro}</p>
      <p>{ui.requiredNote}</p>
      <form
        class="form"
        name={s.formName}
        method="POST"
        action="/thank-you"
        data-netlify="true"
        netlify-honeypot="bot-field"
      >
        <input type="hidden" name="form-name" value={s.formName} />
        <p class="hidden-field">
          <label>{ui.honeypotLabel} <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
        </p>

        <div class="field">
          <label for="company">{f.company} <span class="req" aria-hidden="true">*</span></label>
          <input id="company" name="company" type="text" autocomplete="organization" required />
        </div>
        <div class="field">
          <label for="contact">{f.contact} <span class="req" aria-hidden="true">*</span></label>
          <input id="contact" name="contact" type="text" autocomplete="name" required />
        </div>
        <div class="field">
          <label for="phone">{f.phone} <span class="req" aria-hidden="true">*</span></label>
          <input id="phone" name="phone" type="tel" autocomplete="tel" required />
        </div>
        <div class="field">
          <label for="email">{f.email} <span class="req" aria-hidden="true">*</span></label>
          <input id="email" name="email" type="email" autocomplete="email" required />
        </div>
        <div class="field">
          <label for="trade">{f.trade} <span class="req" aria-hidden="true">*</span></label>
          <input id="trade" name="trade" type="text" required />
        </div>
        <div class="field">
          <label for="license">{f.license}</label>
          <input id="license" name="license" type="text" />
        </div>
        <div class="field">
          <label for="islands">{f.islands}</label>
          <input id="islands" name="islands" type="text" />
        </div>
        <fieldset class="field">
          <legend>{f.insurance}</legend>
          <div class="radio-row">
            <label><input type="radio" name="insurance" value="Yes" /> {s.yes}</label>
            <label><input type="radio" name="insurance" value="No" /> {s.no}</label>
          </div>
        </fieldset>
        <div class="field">
          <label for="note">{f.note}</label>
          <textarea id="note" name="note"></textarea>
        </div>
        <button class="btn" type="submit">{ui.submit}</button>
      </form>
    </div>
  </section>
</Base>
