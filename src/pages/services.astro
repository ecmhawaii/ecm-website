---
import Base from '../layouts/Base.astro';
import { services, ui } from '../content/site';
---
<Base title={services.title} description={services.description}>
  <section class="section">
    <div class="container">
      <h1>{services.h1}</h1>
      <div class="accordion">
        {services.items.map((item) => (
          <details id={item.id}>
            <summary>{item.name}</summary>
            <div class="panel"><p>{item.text}</p></div>
          </details>
        ))}
      </div>
      <p class="prose" style="margin-top: 24px">{services.subsLine}</p>
      <a class="btn" href="/start-your-project">{ui.estimateButton}</a>
    </div>
  </section>
</Base>
