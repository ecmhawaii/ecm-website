---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../content/site';
---
<Base title={projects.title} description={projects.description}>
  <section class="section">
    <div class="container">
      <h1>{projects.h1}</h1>
      <p class="prose">{projects.text}</p>
      {projects.cards.length > 0 && (
        <ul class="card-grid">
          {projects.cards.map((card) => (
            <li><ProjectCard {...card} /></li>
          ))}
        </ul>
      )}
    </div>
  </section>
</Base>
