---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ClientsStrip from '../components/ClientsStrip.astro';
import Hook from '../components/Hook.astro';
import ServicesList from '../components/ServicesList.astro';
import FeaturedProjects from '../components/FeaturedProjects.astro';
import PhotoBand from '../components/PhotoBand.astro';
import Slider from '../components/Slider.astro';
import Eyebrow from '../components/Eyebrow.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Reviews from '../components/Reviews.astro';
import TrustedBy from '../components/TrustedBy.astro';
import InstagramFeed from '../components/InstagramFeed.astro';
import Financing from '../components/Financing.astro';
import Faq from '../components/Faq.astro';
import EstimateBand from '../components/EstimateBand.astro';
import { home } from '../content/site';
import { sliderKeys } from '../content/images';
import { faqSchema } from '../lib/schema';
---
<Base title={home.title} description={home.description} schema={faqSchema('home')}>
  <Hero eyebrow={home.eyebrow} h1={home.h1} line={home.heroLine} />
  <ClientsStrip />
  <Hook />
  <ServicesList />
  <FeaturedProjects />
  <PhotoBand image={home.bandImage} />
  <section class="section" aria-labelledby="slider-h">
    <div class="container">
      <Eyebrow text={home.sliderEyebrow} />
      <h2 id="slider-h" data-reveal>{home.sliderHeading}</h2>
      <Slider slots={sliderKeys} />
    </div>
  </section>
  <HowItWorks />
  <Reviews />
  <TrustedBy />
  <InstagramFeed />
  <div class="container"><Financing /></div>
  <Faq page="home" eyebrow={home.faqEyebrow} heading={home.faqHeading} />
  <EstimateBand />
</Base>
