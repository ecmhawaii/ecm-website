---
// Contact page (2026-11-25): call, request an estimate, or send a message.
// The message form is a Netlify form named "contact". This built HTML is the static
// definition Netlify detects at deploy, like the estimate and subcontractor forms.
// Its input named "email" (type email) sets the Reply-To on Netlify's notification email.
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Phone from '../components/Phone.astro';
import FormAgreement from '../components/FormAgreement.astro';
import { contact as c, ui, siteVisitCopy } from '../content/site';
import DraftTag from '../components/DraftTag.astro';
const f = c.fields;
---
<Base title={c.title} description={c.description} crumbs={[{ name: c.h1, path: '/contact' }]}>
  <PageHead h1={c.h1} lead={c.intro} />
  <section class="section">
    <div class="container contact-grid">
      <div class="contact-side">
        <div class="contact-option">
          <h2 id="contact-call-h" class="contact-h">{c.callHeading}</h2>
          <p class="contact-phone"><Phone /></p>
        </div>
        <div class="contact-option">
          <h2 id="contact-estimate-h" class="contact-h">{c.estimateHeading}</h2>
          <p><DraftTag item={siteVisitCopy.contactEstimate} />{c.estimateLine}</p>
          <a class="btn btn-lg btn-arrow" href="/start-your-project">{ui.estimateButton}</a>
        </div>
      </div>
      <div class="contact-option contact-message">
        <h2 id="contact-message-h" class="contact-h">{c.messageHeading}</h2>
        <p>{c.messageLine}</p>
        <p class="form-note">{ui.requiredNote}</p>
        <form
          class="form"
          name={c.formName}
          method="POST"
          action="/thank-you?form=contact"
          data-netlify="true"
          netlify-honeypot="bot-field"
          data-contact-form
        >
          <input type="hidden" name="form-name" value={c.formName} />
          <input type="hidden" name="subject" value={c.defaultSubject} data-subject-prefix={c.subjectPrefix} />
          <input type="hidden" name="lead-type" value={c.leadType} />
          <input type="hidden" name="form-version" value={c.formVersion} />
          <input type="hidden" name="source-page" value="/contact" />
          <p class="hidden-field">
            <label>{ui.honeypotLabel} <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
          </p>
          <div class="field">
            <label for="contact-name">{f.name} <span aria-hidden="true">*</span></label>
            <input id="contact-name" name="name" type="text" autocomplete="name" required />
          </div>
          <div class="field">
            <label for="contact-email">{f.email} <span aria-hidden="true">*</span></label>
            <input id="contact-email" name="email" type="email" autocomplete="email" required />
          </div>
          <div class="field">
            <label for="contact-subject">{f.subject} <span aria-hidden="true">*</span></label>
            <input id="contact-subject" name="message-subject" type="text" maxlength="120" required />
          </div>
          <div class="field">
            <label for="contact-message">{f.message} <span aria-hidden="true">*</span></label>
            <textarea id="contact-message" name="message" required></textarea>
          </div>
          <FormAgreement button={ui.submit} />
          <button class="btn btn-lg" type="submit">{ui.submit}</button>
        </form>
      </div>
    </div>
  </section>
</Base>

<script>
  // Puts the visitor's subject into the notification email subject (JS off keeps the default),
  // and tells the thank you page to show the message version of its text.
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  form?.addEventListener('submit', () => {
    const subject = form.elements.namedItem('subject') as HTMLInputElement;
    const typed = ((form.elements.namedItem('message-subject') as HTMLInputElement | null)?.value ?? '').trim().slice(0, 80).trim();
    if (typed) subject.value = `${subject.dataset.subjectPrefix}: ${typed}`;
    try { sessionStorage.setItem('ecm-thank-you', JSON.stringify({ form: 'contact' })); } catch {}
  });
</script>
