---
// One photo slot from src/content/images.ts.
// Local ECM photos go through Astro's Image (resized, WebP, width/height set so nothing shifts).
// Remote sample photos are plain <img> with a visible "Sample photo" tag and data-placeholder
// (checked by check:launch). Empty slots show a plain gray block.
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { photos } from '../content/images';
import { ui } from '../content/site';
import { placeholderClass, imageBaseName } from '../lib/placeholder-class.mjs';

interface Props {
  image: string;
  /** sizes attribute: how wide the photo shows on screen. */
  sizes?: string;
  widths?: number[];
  ratio?: 'wide' | 'photo' | 'square' | 'tall' | 'band' | 'none';
  eager?: boolean;
  emptyLabel?: string;
  class?: string;
  imgClass?: string;
  /** Optional caption shown under the photo (real photos only). */
  caption?: string;
  /** Server-side crop aspect (width / height) when ratio is 'none' (photo bands). */
  crop?: number;
  /** WebP quality. Lower for photos under a dark overlay. */
  quality?: number;
  /**
   * The same photo already rendered by another layout of the same component on this page, and
   * never shown at the same time (home services list: phone list vs desktop preview). The build
   * check for repeated photos (scripts/photo-checks.mjs) skips it.
   */
  layoutCopy?: boolean;
  /** The page's LCP photo: also fetchpriority high. Plain `eager` only stops lazy loading. */
  lcp?: boolean;
  /**
   * Deferred: no src in the HTML. scripts/photo-fade.ts sets it once the page has loaded or the
   * photo comes within 600px of the screen, whichever is first, so it never shares bandwidth with
   * the LCP photo. JS off: a <noscript> copy shows the photo normally. Never for a first-screen photo.
   */
  deferred?: boolean;
}
const {
  image: slot, sizes = '(min-width: 960px) 50vw, 100vw', widths = [480, 800, 1200], ratio = 'photo',
  eager = false, emptyLabel = ui.photoComing, class: cls = '', imgClass = '', caption, crop, quality = 58, layoutCopy = false, lcp = false, deferred = false,
} = Astro.props;
const p = photos[slot];
const isLocal = p && typeof p.src !== 'string';
const remote = p && typeof p.src === 'string' ? (p.src as string) : '';
const remoteSrc = remote && ratio !== 'band' && !sizes.includes('100vw') ? remote.replace('w=1600', 'w=900') : remote;
const pos = `pos-${p?.position ?? 'center'}`;
// Build time placeholder: a gradient of the photo's own colors (scripts/placeholders.mjs).
const ph = isLocal ? placeholderClass(imageBaseName((p.src as ImageMetadata).src)) : '';
const localW = isLocal ? (p.src as ImageMetadata).width : 0;
// Crop on the server to the shape the slot shows, so no hidden pixels are downloaded.
const aspects: Record<string, number> = { photo: 4 / 3, square: 1, tall: 3 / 4, wide: 16 / 9 };
const aspect = p?.keepAspect ? undefined : crop ?? aspects[ratio];
const sharpPos: Record<string, string> = { top: 'top', upper: 'center', center: 'center', lower: 'center', bottom: 'bottom' };
// Never upscale: drop widths larger than the source and offer the source width itself instead.
const fitWidths = isLocal ? [...new Set([...widths.filter((w) => w <= localW), ...(widths.some((w) => w > localW) ? [localW] : [])])] : [];
const imgOpts = isLocal ? {
  src: p.src as ImageMetadata,
  widths: fitWidths,
  width: aspect ? Math.max(...fitWidths) : undefined,
  height: aspect ? Math.round(Math.max(...fitWidths) / aspect) : undefined,
  fit: aspect ? ('cover' as const) : undefined,
  position: aspect ? sharpPos[p.position ?? 'center'] : undefined,
  format: 'webp' as const,
  quality,
} : null;
const later = deferred && !eager && imgOpts ? await getImage(imgOpts) : null;
---
<figure class:list={['photo', `ratio-${ratio}`, ph, cls]} data-placeholder={p?.placeholder && (isLocal || remote) ? 'true' : undefined}>
  {later ? (
    <Fragment>
      <img
        data-defer-src={later.src}
        data-defer-srcset={later.srcSet.attribute}
        sizes={sizes}
        alt={p.alt}
        width={later.attributes.width}
        height={later.attributes.height}
        loading="lazy"
        decoding="async"
        class:list={[pos, imgClass]}
        data-photo
        data-layout-copy={layoutCopy ? 'true' : undefined}
      />
      <noscript><img src={later.src} srcset={later.srcSet.attribute} sizes={sizes} alt={p.alt} width={later.attributes.width} height={later.attributes.height} loading="lazy" decoding="async" class:list={[pos, imgClass]} data-photo data-layout-copy={layoutCopy ? 'true' : undefined} /></noscript>
    </Fragment>
  ) : isLocal ? (
    <Image
      src={p.src as ImageMetadata}
      alt={p.alt}
      widths={fitWidths}
      width={aspect ? Math.max(...fitWidths) : undefined}
      height={aspect ? Math.round(Math.max(...fitWidths) / aspect) : undefined}
      fit={aspect ? 'cover' : undefined}
      position={aspect ? sharpPos[p.position ?? 'center'] : undefined}
      sizes={sizes}
      format="webp"
      quality={quality}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager && lcp ? 'high' : undefined}
      decoding="async"
      class:list={[pos, imgClass]}
      data-photo
      data-layout-copy={layoutCopy ? 'true' : undefined}
    />
  ) : remote ? (
    <img src={remoteSrc} alt={p.alt} width={p.width} height={p.height} loading={eager ? 'eager' : 'lazy'} decoding="async" referrerpolicy="no-referrer" class:list={[pos, imgClass]} data-photo />
  ) : (
    <div class="photo-empty"><span>{emptyLabel}</span></div>
  )}
  {p?.placeholder && (isLocal || remote) && <span class="sample-tag">{ui.samplePhoto}</span>}
  {caption && !p?.placeholder && <figcaption class="photo-caption">{caption}</figcaption>}
</figure>
