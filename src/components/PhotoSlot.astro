---
// One photo slot. Reads from src/content/images.ts.
// Placeholder stock photos get a visible "Sample photo" tag and data-placeholder (checked by check:launch).
// Empty slots show a plain gray block.
import { photos, cardSrc } from '../content/images';
import { ui } from '../content/site';

interface Props {
  slot: string;
  size?: 'full' | 'card';
  ratio?: 'wide' | 'photo' | 'square' | 'tall';
  eager?: boolean;
  emptyLabel?: string;
  class?: string;
}
const { slot, size = 'full', ratio = 'photo', eager = false, emptyLabel = ui.photoComing, class: cls = '' } = Astro.props;
const p = photos[slot];
const src = p ? (size === 'card' ? cardSrc(slot) : p.src) : '';
---
<figure class:list={['photo', `ratio-${ratio}`, cls]} data-placeholder={p?.placeholder && src ? 'true' : undefined}>
  {src ? (
    <Fragment>
      <img
        src={src}
        alt={p.alt}
        width={size === 'card' ? 800 : p.width}
        height={size === 'card' ? Math.round((800 * p.height) / p.width) : p.height}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        referrerpolicy="no-referrer"
      />
      {p.placeholder && <figcaption class="sample-tag">{ui.samplePhoto}</figcaption>}
    </Fragment>
  ) : (
    <div class="photo-empty"><span>{emptyLabel}</span></div>
  )}
</figure>
