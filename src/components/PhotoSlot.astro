---
// One photo slot from src/content/images.ts.
// Local ECM photos go through Astro's Image (resized, WebP, width/height set so nothing shifts).
// Remote sample photos are plain <img> with a visible "Sample photo" tag and data-placeholder
// (checked by check:launch). Empty slots show a plain gray block.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { photos } from '../content/images';
import { ui } from '../content/site';

interface Props {
  image: string;
  /** sizes attribute: how wide the photo shows on screen. */
  sizes?: string;
  widths?: number[];
  ratio?: 'wide' | 'photo' | 'square' | 'tall' | 'band' | 'none';
  eager?: boolean;
  emptyLabel?: string;
  class?: string;
  imgClass?: string;
  /** Optional caption shown under the photo (real photos only). */
  caption?: string;
}
const {
  image: slot, sizes = '(min-width: 960px) 50vw, 100vw', widths = [480, 800, 1200], ratio = 'photo',
  eager = false, emptyLabel = ui.photoComing, class: cls = '', imgClass = '', caption,
} = Astro.props;
const p = photos[slot];
const isLocal = p && typeof p.src !== 'string';
const remote = p && typeof p.src === 'string' ? (p.src as string) : '';
const remoteSrc = remote && ratio !== 'band' && !sizes.includes('100vw') ? remote.replace('w=1600', 'w=900') : remote;
const pos = `pos-${p?.position ?? 'center'}`;
const localW = isLocal ? (p.src as ImageMetadata).width : 0;
const fitWidths = isLocal ? (widths.filter((w) => w <= localW).length ? widths.filter((w) => w <= localW) : [localW]) : [];
---
<figure class:list={['photo', `ratio-${ratio}`, cls]} data-placeholder={p?.placeholder && (isLocal || remote) ? 'true' : undefined}>
  {isLocal ? (
    <Image
      src={p.src as ImageMetadata}
      alt={p.alt}
      widths={fitWidths}
      sizes={sizes}
      format="webp"
      quality={72}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
      decoding="async"
      class:list={[pos, imgClass]}
      data-photo
    />
  ) : remote ? (
    <img src={remoteSrc} alt={p.alt} width={p.width} height={p.height} loading={eager ? 'eager' : 'lazy'} decoding="async" referrerpolicy="no-referrer" class:list={[pos, imgClass]} data-photo />
  ) : (
    <div class="photo-empty"><span>{emptyLabel}</span></div>
  )}
  {p?.placeholder && (isLocal || remote) && <span class="sample-tag">{ui.samplePhoto}</span>}
  {caption && !p?.placeholder && <figcaption class="photo-caption">{caption}</figcaption>}
</figure>
