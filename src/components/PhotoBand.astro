---
// Full-width photo band with a slow parallax on desktop (motion module).
import PhotoSlot from './PhotoSlot.astro';
interface Props { image: string }
---
<div class="photo-band cv-auto" data-parallax>
  <PhotoSlot image={Astro.props.image} ratio="none" crop={16 / 10} quality={50} sizes="100vw" widths={[640, 960, 1216, 1600]} class="band-photo" />
</div>
