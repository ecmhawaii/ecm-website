---
// Visible Q and A. Pages pass the same items to Base as FAQPage structured data (lib/schema.ts).
// Renders nothing while the list in site.ts is empty.
import { faqs, ui } from '../content/site';
import Eyebrow from './Eyebrow.astro';
interface Props { page: string; eyebrow?: string; heading?: string }
const { page, eyebrow = 'FAQ', heading = ui.faqHeading } = Astro.props;
const items = faqs[page] ?? [];
---
{items.length > 0 && (
  <section class="section faq" aria-labelledby="faq-heading">
    <div class="container faq-grid">
      <div>
        <Eyebrow text={eyebrow} />
        <h2 id="faq-heading" data-reveal>{heading}</h2>
      </div>
      <div class="faq-list">
        {items.map((f) => (
          <details data-reveal><summary>{f.q}</summary><div class="panel"><p>{f.a}</p></div></details>
        ))}
      </div>
    </div>
  </section>
)}
