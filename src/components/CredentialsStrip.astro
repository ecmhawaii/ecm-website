---
// Only confirmed facts. The insurance line is a hidden slot (slots.insurance in site.ts).
import { credentials, slots } from '../content/site';
const items = [...credentials, ...(slots.insurance.enabled && slots.insurance.text ? [slots.insurance.text] : [])];
---
<div class="cred-strip">
  <ul class="container">
    {items.map((c) => <li><span class="cred-mark" aria-hidden="true"></span>{c}</li>)}
  </ul>
</div>
