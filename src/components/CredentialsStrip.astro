---
// Only confirmed facts, separated by a middle dot (CSS), never a dash.
// The insurance line is a hidden slot (slots.insurance in site.ts).
import { credentials, slots } from '../content/site';
interface Props { variant?: 'hero' | 'bar' }
const { variant = 'bar' } = Astro.props;
const items = [...credentials, ...(slots.insurance.enabled && slots.insurance.text ? [slots.insurance.text] : [])];
---
<div class:list={['cred-strip', `cred-${variant}`]} data-hero-fade={variant === 'hero' ? '' : undefined}>
  <ul class="container">
    {items.map((c) => <li>{c}</li>)}
  </ul>
</div>
