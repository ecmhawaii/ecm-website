---
// Only confirmed facts (plus drafts on previews), separated by a middle dot, never a dash.
// The insurance line is a hidden slot (slots.insurance in site.ts).
// Separators (2026-11-26): each dot sits in the gap before its item and the list is shifted left
// by one gap inside a clipping box, so the dot of any item that starts a line is clipped. A dot
// can never start or end a line, at any width and with any number of items.
import Draft from './Draft.astro';
import { credentialItems } from '../lib/credentials';
interface Props { variant?: 'hero' | 'bar' }
const { variant = 'bar' } = Astro.props;
const items = credentialItems();
---
<div class:list={['cred-strip', `cred-${variant}`]} data-hero-in={variant === 'hero' ? '4' : undefined}>
  <div class="container">
    <div class="cred-clip">
      <ul>
        {items.map((c) => <li>{c.draft ? <Draft inline item={c.draft}>{c.text}</Draft> : c.text}</li>)}
      </ul>
    </div>
  </div>
</div>
