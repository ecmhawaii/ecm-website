---
// Project card for real ECM projects (portfolio page).
import PhotoSlot from './PhotoSlot.astro';
import Compare from './Compare.astro';
import { projects, ui } from '../content/site';
import { photos } from '../content/images';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Project } from '../content/site';

interface Props { project: Project; /** First project sits on the first screen: never hidden for a reveal. */ first?: boolean }
const { project: p, first = false } = Astro.props;
const reveal = first ? undefined : '';

// Full-size versions for the lightbox (also the no-JS link target).
const gallery = await Promise.all(
  (p.gallery ?? []).map(async (g) => {
    const slot = photos[g.image];
    const src = slot.src as ImageMetadata;
    // Capped so no full-size lightbox file is over 400 kB (pre-launch audit finding 28).
    // Long edge at most 1600px (tall phone photos too), WebP quality 65.
    const scale = Math.min(1, 1600 / Math.max(src.width, src.height));
    const full = await getImage({ src, width: Math.round(src.width * scale), format: 'webp', quality: 65 });
    return { ...g, full: full.src, alt: slot.alt };
  })
);
---
<article class="project" id={p.id} aria-labelledby={`${p.id}-h`}>
  <div class="project-head" data-reveal={reveal}>
    <p class="card-meta">{p.type}{p.place && <Fragment> · {p.place}</Fragment>}</p>
    <h2 id={`${p.id}-h`}>{p.name}</h2>
    <p class="lead">{p.summary}</p>
  </div>
  {p.compare && (
    <div class="project-compare">
      <h3 class="sub-head">{projects.compareHeading}</h3>
      <Compare {...p.compare} name={p.name} />
    </div>
  )}
  {gallery.length > 0 && (
    <div class="project-gallery">
      <h3 class="sub-head" data-reveal={reveal}>{projects.galleryHeading}</h3>
      <ul class="gallery-grid" data-gallery>
        {gallery.map((g, i) => (
          <li>
            <a class="gallery-link lift" href={g.full} data-lightbox data-caption={g.caption} data-alt={g.alt} data-index={i}>
              {/* The first project's gallery is on the first screen at 1440px: not lazy (2026-11-27). */}
              <PhotoSlot image={g.image} ratio="square" quality={42} sizes="(min-width: 960px) 25vw, 50vw" widths={[240, 360, 720]} eager={first} />
              <span class="sr-only">{ui.openPhoto}: {g.caption}</span>
            </a>
            <p class="gallery-caption">{g.caption}</p>
          </li>
        ))}
      </ul>
    </div>
  )}
</article>
