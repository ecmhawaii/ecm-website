---
// Reusable project card. Not shown on the site until the owner approves projects and photos.
import PhotoPlaceholder from './PhotoPlaceholder.astro';

interface Props {
  type: string;
  island: string;
  summary: string;
  photo?: string;
  photoAlt?: string;
}

const { type, island, summary, photo, photoAlt = '' } = Astro.props;
---
<article class="card project-card">
  {photo ? <img src={photo} alt={photoAlt} loading="lazy" /> : <PhotoPlaceholder />}
  <div class="card-body">
    <h2 class="card-title">{type}</h2>
    <p class="project-island">{island}</p>
    <p>{summary}</p>
  </div>
</article>
